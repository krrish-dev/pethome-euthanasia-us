---
import { servicePages } from '../../data/seo-pages';

export function getStaticPaths() {
  return servicePages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
const canonical = `https://pethomeeuthanasia.us/services/${page.slug}`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <title>{page.title}</title>
  <meta name="description" content={page.description}>
  <link rel="canonical" href={canonical}>
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/home.css">
  <style>
    .seo-hero { background: linear-gradient(135deg, var(--color-hero-deep), var(--color-hero-dark) 64%, var(--color-primary-700)); color: var(--color-text-inverse); padding-block: var(--space-18) var(--space-14); text-align: center; }
    .seo-hero h1 { color: var(--color-text-inverse); margin-inline: auto; }
    .seo-hero .lead { color: rgba(251,250,246,.88); max-width: 70ch; margin: var(--space-4) auto 0; }
    .breadcrumbs { font-size: var(--text-sm); display: flex; justify-content: center; gap: var(--space-2); flex-wrap: wrap; margin-bottom: var(--space-6); color: rgba(251,250,246,.78); }
    .breadcrumbs a { color: rgba(251,250,246,.86); }
    .seo-layout { display: grid; grid-template-columns: 1fr; gap: var(--space-10); }
    @media (min-width: 960px) { .seo-layout { grid-template-columns: minmax(0, 1fr) 20rem; align-items: start; } }
    .seo-card { background: var(--color-surface-raised); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-lg); padding: var(--space-7); box-shadow: var(--shadow-sm); }
    .seo-section + .seo-section { margin-top: var(--space-10); }
    .seo-section h2 { font-size: var(--text-3xl); margin-bottom: var(--space-4); }
    .seo-section p { font-size: var(--text-lg); color: var(--color-text-body); line-height: var(--leading-relaxed); }
    .seo-list { margin-top: var(--space-5); display: grid; gap: var(--space-3); padding-left: 1.25rem; }
    .faq-list { display: grid; gap: var(--space-5); }
    .faq-item { background: var(--color-surface-raised); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-md); padding: var(--space-5); }
    .faq-item h3 { color: var(--color-primary-700); font-size: var(--text-lg); margin-bottom: var(--space-2); }
    .sidebar-box { position: sticky; top: var(--space-6); }
    .sidebar-box a { width: 100%; margin-top: var(--space-4); }
    .link-grid { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-5); }
    .link-grid a { border: 1px solid var(--color-primary-200); border-radius: var(--radius-md); padding: var(--space-2) var(--space-4); text-decoration: none; color: var(--color-primary-700); background: var(--color-surface-page); }
  </style>
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>
  <header class="nav" id="site-nav">
    <div class="container nav__inner">
      <a href="/" class="nav__brand">Pet Home Euthanasia</a>
      <a href="tel:+17609120848" class="nav__mobile-call" aria-label="Call now">☎</a>
      <button class="nav__toggle" aria-expanded="false" aria-controls="nav-links" aria-label="Open navigation menu">☰</button>
      <ul class="nav__links" id="nav-links" role="list">
        <li><a href="/">Home</a></li>
        <li><a href="/about">About Us</a></li>
        <li><a href="/services" class="is-active">Services</a></li>
        <li><a href="/pricing">Pricing</a></li>
        <li><a href="/service-areas">Service Areas</a></li>
        <li><a href="/faq">FAQ</a></li>
      </ul>
      <div class="nav__actions"><a href="tel:+17609120848" class="btn btn--primary btn--sm">Call now</a></div>
    </div>
  </header>

  <main id="main">
    <section class="seo-hero">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span><a href="/services">Services</a><span>/</span><span aria-current="page">{page.h1}</span>
        </nav>
        <span class="section-label" style="justify-content:center;color:inherit;">{page.eyebrow}</span>
        <h1>{page.h1}</h1>
        <p class="lead">{page.intro}</p>
        <div style="margin-top: var(--space-8); display:flex; gap:var(--space-4); justify-content:center; flex-wrap:wrap;">
          <a href="tel:+17609120848" class="btn btn--primary btn--lg">Call (760) 912-0848</a>
          <a href="/pricing" class="btn btn--secondary btn--lg">View Pricing</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container seo-layout">
        <article>
          {page.sections.map((section) => (
            <section class="seo-section">
              <h2>{section.heading}</h2>
              <p>{section.body}</p>
              {section.bullets && <ul class="seo-list">{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}
            </section>
          ))}

          <section class="seo-section">
            <h2>Common Questions</h2>
            <div class="faq-list">
              {page.faqs.map((faq) => (
                <article class="faq-item">
                  <h3>{faq.question}</h3>
                  <p>{faq.answer}</p>
                </article>
              ))}
            </div>
          </section>

          <section class="seo-section">
            <h2>Related Local Pages</h2>
            <p>Families also compare services by city, appointment timing, and aftercare options. These pages help you choose the most relevant next step.</p>
            <div class="link-grid">
              <a href="/service-areas/victorville">Victorville</a>
              <a href="/service-areas/apple-valley">Apple Valley</a>
              <a href="/service-areas/hesperia">Hesperia</a>
              <a href="/service-areas/rancho-cucamonga">Rancho Cucamonga</a>
              <a href="/service-areas/riverside">Riverside</a>
              <a href="/service-areas/los-angeles">Los Angeles</a>
            </div>
          </section>
        </article>

        <aside class="seo-card sidebar-box">
          <h2 style="font-size: var(--text-2xl);">Need help now?</h2>
          <p>{page.cta}</p>
          <a href="tel:+17609120848" class="btn btn--primary btn--block">Call Now</a>
          <a href="/contact" class="btn btn--secondary btn--block">Contact Us</a>
          <hr style="margin-block: var(--space-6); border:0; border-top:1px solid var(--color-border-subtle);">
          <p style="font-size: var(--text-sm); color: var(--color-text-muted);">Serving Southern California by appointment, including High Desert, Inland Empire, Riverside, Los Angeles, and Orange County communities.</p>
        </aside>
      </div>
    </section>
  </main>
  <script src="/js/site.js" defer></script>
</body>
</html>
