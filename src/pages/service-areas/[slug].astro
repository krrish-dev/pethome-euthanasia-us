---
import { expandedServiceAreas, requestedServiceAreas } from '../../data/expanded-service-areas';

export function getStaticPaths() {
  return expandedServiceAreas.map((area) => ({ params: { slug: area.slug }, props: { area } }));
}

const { area } = Astro.props;
const canonical = `https://pethomeeuthanasia.us/service-areas/${area.slug}`;
const knownSlugs = new Set(requestedServiceAreas.map((item) => item.slug));
const nearbyAreas = area.nearby
  .filter((slug) => knownSlugs.has(slug))
  .map((slug) => requestedServiceAreas.find((item) => item.slug === slug))
  .filter(Boolean);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <title>{`In-Home Pet Euthanasia in ${area.name}, CA | Mobile Vet Care`}</title>
  <meta name="description" content={`Compassionate in-home pet euthanasia in ${area.name}, CA for dogs and cats. Mobile veterinarian appointments, quality-of-life guidance, and aftercare planning in ${area.county}.`}>
  <link rel="canonical" href={canonical}>
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/home.css">
  <link rel="stylesheet" href="/css/seo-layout.css">
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>
  <header class="nav" id="site-nav">
    <div class="container nav__inner">
      <a href="/" class="nav__brand">Pet Home Euthanasia Service</a>
      <a href="tel:+17609120848" class="nav__mobile-call" aria-label="Call now">Call</a>
      <button class="nav__toggle" aria-expanded="false" aria-controls="nav-links" aria-label="Open navigation menu">Menu</button>
      <ul class="nav__links" id="nav-links" role="list">
        <li><a href="/">Home</a></li>
        <li><a href="/about">About Us</a></li>
        <li><a href="/services">Services</a></li>
        <li><a href="/pricing">Pricing</a></li>
        <li><a href="/service-areas" class="is-active">Service Areas</a></li>
        <li><a href="/faq">FAQ</a></li>
      </ul>
      <div class="nav__actions"><a href="tel:+17609120848" class="btn btn--primary btn--sm">Call now</a></div>
    </div>
  </header>

  <main id="main" class="city-source-rewrite">
    <section class="city-hero" style="background:linear-gradient(135deg,var(--color-hero-deep),var(--color-hero-dark) 62%,var(--color-primary-700));color:var(--color-text-inverse);">
      <div class="city-shell city-hero__inner" style="position:relative;z-index:1;">
        <div class="city-hero__copy">
          <nav class="breadcrumbs" aria-label="Breadcrumb" style="color:rgba(255,255,255,.78);">
            <a href="/" style="color:rgba(255,255,255,.86);">Home</a><span>/</span><a href="/service-areas" style="color:rgba(255,255,255,.86);">Service Areas</a><span>/</span><span aria-current="page">{area.name}</span>
          </nav>
          <span class="section-label" style="color:inherit;">{area.region} mobile veterinary care</span>
          <h1>In-Home Pet Euthanasia in {area.name}, CA</h1>
          <p class="lead" style="max-width:74ch;margin:var(--space-5) 0 0;color:rgba(255,255,255,.88);">Families in {area.name} can request compassionate in-home pet euthanasia for dogs and cats when a clinic visit feels too stressful, painful, or difficult. The visit is planned around comfort, privacy, and respectful aftercare.</p>
          <div class="btn-group" style="margin-top:var(--space-8);">
            <a href="tel:+17609120848" class="btn btn--primary btn--lg">Call (760) 912-0848</a>
            <a href="/pricing" class="btn btn--secondary btn--lg">View Pricing</a>
          </div>
        </div>
        <figure class="city-hero-media">
          <img src="/assets/images/generated/home-hero-compassionate-care.png" alt={`Compassionate in-home pet euthanasia support for families in ${area.name}`} width="1672" height="941" loading="eager" decoding="async" fetchpriority="high">
        </figure>
      </div>
    </section>

    <section class="section">
      <div class="city-shell city-layout">
        <article>
          <section class="city-cta-panel city-content-block">
            <h2>Compassionate at-home care in {area.name}</h2>
            <p>Our mobile veterinarian helps families understand the process, prepare a calm space, decide on aftercare, and avoid unnecessary transport when a pet is fragile, painful, or anxious.</p>
          </section>

          <section class="city-content-block">
            <h2>Local appointment planning for {area.name}</h2>
            <p>{area.name} is part of the {area.cluster} service plan in {area.county}. Calling with your pet’s approximate weight, symptoms, mobility level, preferred timing, and aftercare preference helps confirm the most realistic appointment window.</p>
          </section>

          <section class="city-content-block">
            <h2>Dog euthanasia at home in {area.name}</h2>
            <p>For senior dogs, large dogs, or dogs with severe pain, weakness, cancer, organ failure, or mobility decline, a home visit can prevent the stress of lifting, car travel, and clinic waiting rooms. Your dog can rest on a favorite bed, blanket, couch, or quiet outdoor area if appropriate.</p>
            <ul class="seo-list">
              <li>Comfort-focused sedation before the final medication</li>
              <li>Private time for family members to be present or step away</li>
              <li>Helpful for dogs who cannot walk, stand, or travel comfortably</li>
              <li>Aftercare and cremation options can be discussed before the visit</li>
            </ul>
          </section>

          <section class="city-content-block">
            <h2>Cat euthanasia at home in {area.name}</h2>
            <p>Cats can become extremely stressed by carriers, car rides, unfamiliar sounds, and clinic smells. A home appointment lets your cat remain in a quiet room with familiar people and familiar surroundings while the veterinarian adapts the visit to reduce handling stress.</p>
          </section>

          <section class="city-content-block">
            <h2>Aftercare and cremation options</h2>
            <p>Families in {area.name} can ask about private cremation, communal cremation, memorial keepsakes, and transport coordination. If home burial is being considered, local property and county rules should be checked first.</p>
          </section>

          <section class="city-content-block">
            <h2>{area.name} frequently asked questions</h2>
            <div class="city-faq-grid">
              <article class="city-faq-card faq-item"><h3>Do you provide in-home pet euthanasia in {area.name}?</h3><p>Yes. {area.name} is included in the expanded Southern California service area, subject to schedule, route, and aftercare availability.</p></article>
              <article class="city-faq-card faq-item"><h3>Can same-day help be available?</h3><p>Same-day appointments may be possible depending on veterinarian availability, location, travel timing, and aftercare needs. Calling is best for urgent situations.</p></article>
              <article class="city-faq-card faq-item"><h3>What should I prepare before calling?</h3><p>Share your pet’s species, approximate weight, symptoms, mobility, city, cross streets, preferred time window, and whether you are considering private or communal cremation.</p></article>
              <article class="city-faq-card faq-item"><h3>Can my family stay with my pet?</h3><p>Yes. Family members may stay close, step away, or choose what feels right for them. The visit is designed to be calm and respectful.</p></article>
            </div>
          </section>

          {nearbyAreas.length > 0 && (
            <section class="city-content-block">
              <h2>Nearby service areas</h2>
              <p>Families near {area.name} often compare nearby appointment availability before choosing a time window.</p>
              <div class="city-nearby-grid">
                {nearbyAreas.map((nearby) => (
                  <a class="city-quick-card" href={`/service-areas/${nearby.slug}`}>{nearby.name}</a>
                ))}
              </div>
            </section>
          )}
        </article>

        <aside class="seo-card city-sticky-card" style="padding:var(--seo-card-pad);">
          <h2 style="font-size:var(--text-2xl);">Schedule in {area.name}</h2>
          <p>Call with your pet’s weight, symptoms, city, preferred timing, and aftercare choice if known.</p>
          <div class="stacked-actions">
            <a href="tel:+17609120848" class="btn btn--primary btn--block">Call Now</a>
            <a href="/resources/quality-of-life-scale" class="btn btn--secondary btn--block">Quality of Life Scale</a>
            <a href="/services/pet-cremation-aftercare" class="btn btn--ghost btn--block">Aftercare Guide</a>
          </div>
          <hr style="margin-block:var(--space-6);border:0;border-top:1px solid var(--color-border-subtle);">
          <p style="font-size:var(--text-sm);color:var(--color-text-muted);">Serving {area.name}, {area.county}, and nearby {area.region} communities by appointment.</p>
        </aside>
      </div>
    </section>
  </main>
  <div class="mobile-cta-bar" aria-label="Quick contact actions"><a href="tel:+17609120848" class="btn btn--primary">Call</a><a href="/pricing" class="btn btn--secondary">Pricing</a></div>
  <script src="/js/site.js" defer></script>
</body>
</html>
